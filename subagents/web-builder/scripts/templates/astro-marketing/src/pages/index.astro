---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="min-h-screen">
    <!-- Hero -->
    <section class="container mx-auto px-4 py-24 text-center">
      <h1 class="text-5xl font-bold tracking-tight md:text-7xl">
        {{PROJECT_NAME_TITLE}}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-600 md:text-xl">
        {{DESCRIPTION}}
      </p>
      <div class="mt-10 flex justify-center gap-4">
        <a
          href="#cta"
          class="rounded-md bg-black px-6 py-3 font-medium text-white hover:bg-gray-800"
        >
          Inizia ora
        </a>
        <a
          href="#features"
          class="rounded-md border border-black px-6 py-3 font-medium hover:bg-gray-100"
        >
          Scopri di più
        </a>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="container mx-auto px-4 py-24">
      <h2 class="text-center text-3xl font-bold">Caratteristiche</h2>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        <div class="rounded-lg border p-6">
          <h3 class="text-xl font-semibold">Veloce</h3>
          <p class="mt-2 text-gray-600">
            Astro genera HTML pre-rendered: Lighthouse 95+
          </p>
        </div>
        <div class="rounded-lg border p-6">
          <h3 class="text-xl font-semibold">Semplice</h3>
          <p class="mt-2 text-gray-600">
            Componenti `.astro` con frontmatter logico
          </p>
        </div>
        <div class="rounded-lg border p-6">
          <h3 class="text-xl font-semibold">Tailwind v4</h3>
          <p class="mt-2 text-gray-600">
            Utility-first styling, zero config
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="cta" class="bg-gray-50 py-24">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold">Pronto a iniziare?</h2>
        <a
          href="mailto:hello@{{DOMAIN}}"
          class="mt-8 inline-block rounded-md bg-black px-6 py-3 font-medium text-white hover:bg-gray-800"
        >
          Contattaci
        </a>
      </div>
    </section>

    <footer class="border-t py-8 text-center text-sm text-gray-500">
      © {{YEAR}} {{PROJECT_NAME_TITLE}}. Built with /web-builder.
    </footer>
  </main>
</Layout>
